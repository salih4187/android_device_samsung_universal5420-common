# hal_sensors_default.te

allow hal_sensors_default system_data_file:dir create_dir_perms;
allow hal_sensors_default system_data_file:file create_file_perms;

allow hal_sensors_default sensors_data_file:dir create_dir_perms;
allow hal_sensors_default sensors_data_file:file create_file_perms;

allow hal_sensors_default sysfs_muic:dir r_dir_perms;

allow hal_sensors_default sysfs_input:file rw_file_perms;

allow hal_sensors_default sysfs_input:lnk_file r_file_perms;
allow hal_sensors_default vendor_file:file execmod;
allow hal_sensors_default sysfs:dir { open read search };
allow hal_sensors_default sysfs_batteryinfo:dir search;
allow hal_sensors_default sysfs:file { getattr open read write };
allow hal_sensors_default sysfs_batteryinfo:file { open read };
allow hal_sensors_default sysfs_backlight_writable:dir search;
allow hal_sensors_default device:chr_file read;
allow hal_sensors_default sysfs_graphics:dir search;
allow hal_sensors_default sysfs_graphics:file { getattr open read write };
allow hal_sensors_default sysfs_backlight_writable:file { getattr open read write };
