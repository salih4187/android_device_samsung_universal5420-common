# hal_sensors_default.te

allow hal_sensors_default system_data_file:dir create_dir_perms;
allow hal_sensors_default system_data_file:file create_file_perms;

allow hal_sensors_default sensors_data_file:dir create_dir_perms;
allow hal_sensors_default sensors_data_file:file create_file_perms;

