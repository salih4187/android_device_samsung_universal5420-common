#============= untrusted_app ==============
allow untrusted_app sysfs:dir { open read };
allow untrusted_app sysfs:file { open read getattr };
allow untrusted_app sysfs_mmu:dir search;
allow untrusted_app proc_version:file { open read };
allow untrusted_app proc_interrupts:file { open read };
allow untrusted_app block_device:dir search;
allow untrusted_app sysfs_batteryinfo:dir search;
allow untrusted_app selinuxfs:file read;
